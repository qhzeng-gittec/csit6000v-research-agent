# Copy to .env (never commit it) or export these in your shell. docker compose forwards them.

# Agent model (any OpenAI-compatible endpoint). We used qwen/qwen3.8-27b on OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
# LLM_MAX_TOKENS=16384
# LLM_TEMPERATURE=0

# FACTS judge (any OpenAI-compatible endpoint). We used gpt-6.2-sol.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
