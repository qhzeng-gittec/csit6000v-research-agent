# Copy to .env (never commit it) or export these in your shell. docker compose forwards them.

# Agent model (any OpenAI-compatible endpoint). We used qwen/qwen3.8-27b on OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
# LLM_MAX_TOKENS=16384
# LLM_TEMPERATURE=0
# Extra request fields as JSON, e.g. for a vLLM server: {"chat_template_kwargs":{"enable_thinking":false}}
# LLM_EXTRA_BODY=
# Extra fields for the retry of an empty reply (default: OpenRouter's reasoning cap).
# LLM_EMPTY_RETRY_BODY=

# FACTS judge (any OpenAI-compatible endpoint). We used gpt-6.2-sol.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
# A thinking judge needs room for its reasoning plus one JSON line per sentence (default 16384).
# JUDGE_MAX_TOKENS=32000
# Sent as 0 by default. Set it to an empty value for judges that reject the parameter (e.g. Claude Haiku 5.5).
# JUDGE_TEMPERATURE=
